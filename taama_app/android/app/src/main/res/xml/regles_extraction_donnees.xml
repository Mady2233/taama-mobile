<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : rien n'est sauvegardé dans le cloud ni copié vers un
     nouveau téléphone (token de session, préférences, cache de carte).
     allowBackup="false" seul ne bloque pas le transfert d'appareil à
     appareil. Fichier identique dans taama_app et taama_conducteur. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
